# runtime state / secrets — never commit
*.db
*.db-wal
*.db-shm
# ...except the test fixtures: a console.db the Python reference wrote (parity/gen/gen_xstate_fixture.py)
!backend/crates/nemo-console/tests/fixtures/**/*.db
*.key
secrets/
.env
.env.*
bootstrap-admin.key
# python (only the parity harness's Python reference, parity/.ref/, uses a venv)
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/
# node (frontend has no runtime deps; only the node:test runner is used)
node_modules/
# local artifacts
*.log
screenshots/
.DS_Store
# rust build output
/backend/target/
# the parity harness's extracted Python reference (parity/ref.mjs) and its output
/parity/.ref/
